# ╔══════════════════════════════════════════════════════════════╗
# ║         MANN AI PLATFORM — ENV TEMPLATE                     ║
# ║   Copy this to .env and fill in your values                 ║
# ║   cp .env.example .env                                      ║
# ╚══════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────
# 🗄️  DATABASE
# ─────────────────────────────────────────
DATABASE_URL=postgresql://role.project-ref:password@localhost:5433/postgres

# ─────────────────────────────────────────
# 🔐 AUTH / JWT
# ─────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-min-32-chars
JWT_EXPIRES_IN=24h

# ─────────────────────────────────────────
# 🌐 SERVICE PORTS
# ─────────────────────────────────────────
PORT_FRONTEND=8000
PORT_GATEWAY=5000
PORT_AUTH=3001
PORT_CHAT=3002
PORT_MEMORY=3003
PORT_AGENT=3004
PORT_TOOLS=3005

# ─────────────────────────────────────────
# 🔀 API GATEWAY
# ─────────────────────────────────────────
GATEWAY_URL=http://localhost:5000

# ─────────────────────────────────────────
# 🐘 JUSTPOSTGRES
# ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
JP_MASTER_KEY=your-32-byte-base64-key-here
JP_PORT=3030
JP_ROUTER_SESSION_PORT=5433
JP_ROUTER_POOL_PORT=6544

# ─────────────────────────────────────────
# 🌍 ENVIRONMENT
# ─────────────────────────────────────────
NODE_ENV=development


AWS_REGION=ap-south-1
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────
# 🤖 AGENT LLM
# ─────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b