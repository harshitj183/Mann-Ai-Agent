  "cards": [
    {
      "dot": "cyan",
      "title": "How the system is split",
      "items": [
        "The control plane manages projects and long-running backup, restore, and branch jobs.",
        "The router is the independent data path and reads routing metadata read-only.",
        "Each project gets its own PostgreSQL container and volume."
      ]
    },
    {
      "dot": "rose",
      "title": "Security boundary",
      "items": [
        "The control plane reaches Docker through an allowlisted socket proxy.",
        "Project containers do not receive the Docker socket.",
        "Per-project isolation uses dedicated networks, resource limits, and dropped capabilities."
      ]
    },
    {
      "dot": "emerald",
      "title": "Connection choices",
      "items": [
        "Session mode is exposed on port 5432 for migrations and long-lived connections.",
        "Transaction pooling is exposed on port 6543 for serverless and short-lived clients.",
        "Routing prefers TLS SNI, then username prefixes, then per-project ports."
      ]
    }
  ]
